# Copy to .env and fill in. Never commit .env.
# Provider: groq | openai | gemini (all called through the OpenAI-compatible chat API)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Per provider-request timeout in seconds
LLM_TIMEOUT_S=90
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# PostgreSQL connection string (python scripts/start_db.py prints one for the embedded server)
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/kasparro
